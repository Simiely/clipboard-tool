<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Clipboard</AssemblyName>
    <RootNamespace>ClipboardExe</RootNamespace>
    <Version>0.7.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- WPF temp 项目 (ClipboardExe_*_wpftmp) 自动生成的 AssemblyInfo 与 SDK 默认 GenerateAssemblyInfo 冲突;
         关掉 SDK 自动生成,WPF temp 仍会自己生成它那份,主程序集 assembly attribute 由下面 ItemGroup 显式定义 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 移除 WinForms/Drawing 全局隐式 using（与 WPF 类型冲突：Application/Rectangle 歧义），按需显式引入 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 排除 tools/ 目录(截图工具子项目),不被主项目编译 -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <Page Remove="tools/**" />
    <ApplicationDefinition Remove="tools/**" />
  </ItemGroup>

  <!-- 显式定义主程序集 assembly attributes（替代 SDK 自动生成） -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTitleAttribute">
      <_Parameter1>Clipboard</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyProductAttribute">
      <_Parameter1>Clipboard</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute">
      <_Parameter1>0.7.0</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyFileVersionAttribute">
      <_Parameter1>0.7.0.0</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.Versioning.TargetPlatformAttribute">
      <_Parameter1>Windows</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Windows.ThemeInfoAttribute">
      <_Parameter1>None</_Parameter1>
      <_Parameter2>SourceAssembly</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>