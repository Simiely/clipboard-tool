<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net9.0-windows:官方 Application.SetColorMode(SystemColorMode.Dark) 深色模式 API(.NET 8 无此 API,
         菜单/滚动条/对话框等系统绘制部分整体深色,是"成熟方案非自绘";.NET 9 为 STS(2026-05 EOL),
         个人工具可接受,未来平滑升 .NET 10 LTS——用户机器已装 9.0.5 Desktop Runtime,零额外安装) -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Clipboard</AssemblyName>
    <RootNamespace>ClipboardExe</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 版本线：EXE 独立于 Web 版，0.1.0 起步（发布规范：与 release tag 同步） -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <!-- SetColorMode 在 .NET 9 标记 experimental(WFO5001)，官方深色模式入口，禁用该警告 -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <!-- 单文件框架依赖发布：约 1~3 MB（用户自装 .NET 9 Desktop Runtime） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
