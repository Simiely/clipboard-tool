<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Clipboard</AssemblyName>
    <RootNamespace>ClipboardExe</RootNamespace>
    <Version>0.7.0</Version>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- WPF temp 项目 (ClipboardExe_*_wpftmp) 自动生成的 AssemblyInfo 与 SDK 默认 GenerateAssemblyInfo 冲突;
         关掉 SDK 自动生成,WPF temp 仍会自己生成它那份,主程序集 assembly attribute 由下面 ItemGroup 显式定义 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- 移除 WinForms/Drawing 全局隐式 using（与 WPF 类型冲突：Application/Rectangle 歧义），按需显式引入 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- 排除 tools/ 目录(截图工具子项目),不被主项目编译 -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <EmbeddedResource Remove="tools/**" />
    <Page Remove="tools/**" />
    <ApplicationDefinition Remove="tools/**" />
  </ItemGroup>

  <!-- ===== WpfVisualTreeMcp Inspector (self-hosted "AI 眼睛", DEBUG-only) =====
       让外部 MCP/CLI 经 named pipe 读真实 visual tree / 属性 / 模拟点击,无需原生注入
       (native bootstrapper 需 MSVC 编译,本机无 → self-hosted 是官方 Recommended 路径)。
       仅当本机装有 WpfVisualTreeMcp 且 Debug 构建时启用(DefineConstants 符号随引用存在与否);
       Release 发布产物纯净,不含任何 inspector 代码。 -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug' And Exists('C:\Users\2504\.workbuddy\tools\WpfVisualTreeMcp\inspector\WpfVisualTreeMcp.Inspector.dll')">
    <DefineConstants>$(DefineConstants);WPFMCP_INSPECTOR</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)'=='Debug' And Exists('C:\Users\2504\.workbuddy\tools\WpfVisualTreeMcp\inspector\WpfVisualTreeMcp.Inspector.dll')">
    <Reference Include="WpfVisualTreeMcp.Inspector">
      <HintPath>C:\Users\2504\.workbuddy\tools\WpfVisualTreeMcp\inspector\WpfVisualTreeMcp.Inspector.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="WpfVisualTreeMcp.Shared">
      <HintPath>C:\Users\2504\.workbuddy\tools\WpfVisualTreeMcp\inspector\WpfVisualTreeMcp.Shared.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>