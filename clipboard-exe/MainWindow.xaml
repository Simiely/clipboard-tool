<Window x:Class="ClipboardExe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClipboardExe.Controls"
        Title="剪贴板"
        Width="1000" Height="640" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei"
        FontSize="14"
        SizeChanged="Window_SizeChanged">

    <Grid>
        <!-- 对齐 Web 版 .view：max-width 三档（<1280→960 / ≥1280→1440 / ≥1920→1920，SizeChanged 动态调整）+ padding 24 16 16
             BatchBar 在外层 Grid 底部悬浮（VerticalAlignment=Bottom），不占 ViewGrid 空间——非批量模式下原本预留的 80px 是浪费的固定遮挡
             Stretch：宽度=min(可用宽, MaxWidth)，随窗口拉宽；Center 会收缩到内容宽导致自适应失效 -->
        <Grid Margin="16,24,16,16">
            <Grid x:Name="ViewGrid" MaxWidth="960" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏（对齐 .topbar：elev 底 + raised 阴影 + r-lg 圆角，padding 12 20） -->
                <ctl:NeuBorder Grid.Row="0" Kind="Raised" Margin="0,0,0,14"
                               Background="{StaticResource ElevBrush}"
                               CornerRadius="{StaticResource RadiusLg}">
                    <DockPanel Margin="20,12">
                        <TextBlock Text="📋" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="剪贴板" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <!-- who 区（对齐 .topbar .who：muted 13px；置顶为新增按钮）
                             DockPanel.LastChildFill 默认 true 会把 who 拉伸填满剩余 + 内容从左排，
                             导致 who 紧贴"剪贴板"无间距（与 Web h1{flex:1} 行为相反）。
                             显式 Dock=Right + HorizontalAlignment=Right 强制靠右，对齐 Web flex 行为。-->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ToggleButton x:Name="PinBtn" Style="{StaticResource BtnPin}"
                                          Content="📌 置顶" ToolTip="窗口置顶（其他窗口之上）"
                                          Click="PinBtn_Click"/>
                            <Ellipse Width="10" Height="10" Margin="14,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}"/>
                            <TextBlock Text="本地" Foreground="{StaticResource MutedBrush}" FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>
                            <Button Style="{StaticResource BtnGhostSm}" Content="◐"
                                    IsEnabled="False" ToolTip="无饱和度配色（V2 接入）"/>
                            <Button Style="{StaticResource BtnGhostSm}" Content="密码"
                                    IsEnabled="False" ToolTip="密码（单机版不启用）"/>
                            <Button x:Name="DataBtn" Style="{StaticResource BtnGhostSm}" Content="数据管理"
                                    Click="DataBtn_Click" ToolTip="导入 / 导出 / 清空（本地备份）"/>
                            <Button Style="{StaticResource BtnGhostSm}" Content="退出"
                                    Click="ExitBtn_Click" ToolTip="退出并停止捕获"/>
                        </StackPanel>
                    </DockPanel>
                </ctl:NeuBorder>

                <!-- 工具条（对齐 .tb：elev 底 + raised + r-md，padding 14 12；行1 搜索+存入 / 行2 类型+标签+操作） -->
                <ctl:NeuBorder Grid.Row="1" Kind="Raised" Margin="0,0,0,16"
                               Background="{StaticResource ElevBrush}"
                               CornerRadius="{StaticResource RadiusMd}">
                    <StackPanel Margin="14,12">
                        <!-- 行1：搜索（pill 内嵌）+ 存入（金色 pill 右置） -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                     Tag="搜索内容 / 标题 / 标签…"
                                     TextChanged="Search_TextChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource StoreBtn}"
                                    Content="＋ 存入" Margin="10,0,0,0"
                                    Click="StoreBtn_Click"
                                    ToolTip="存入内容 — 粘贴 / 拖文件 / Ctrl+V 后自动弹出"/>
                        </Grid>
                        <!-- 行2：类型分段（真绑定 RadioButton——契约 #3）+ 标签栏（M3a 轻量：全部 + 当前标签）+ 操作组 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Typetab}">
                                <StackPanel x:Name="TtPanel" Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource TtRadio}" Content="全部" Tag="all"
                                                 GroupName="TypeFilter" IsChecked="True" Checked="TypeRadio_Checked"/>
                                    <RadioButton Style="{StaticResource TtRadio}" Content="文本" Tag="text"
                                                 GroupName="TypeFilter" Checked="TypeRadio_Checked"/>
                                    <RadioButton Style="{StaticResource TtRadio}" Content="链接" Tag="link"
                                                 GroupName="TypeFilter" Checked="TypeRadio_Checked"/>
                                    <RadioButton Style="{StaticResource TtRadio}" Content="文件" Tag="file"
                                                 GroupName="TypeFilter" Checked="TypeRadio_Checked"/>
                                </StackPanel>
                            </Border>
                            <!-- 标签栏（.tagbar：M3a 轻量版——"全部" + 当前过滤标签，点击清除；完整聚合 M3b） -->
                            <StackPanel x:Name="TagBar" Grid.Column="1" Orientation="Horizontal"
                                        Margin="12,0" VerticalAlignment="Center"/>
                            <!-- 操作组（对齐 .tb .ops：编辑/归档/列数/同步） -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="EditBtn" Style="{StaticResource BtnGhostSm}" Content="编辑"
                                        Click="EditBtn_Click" ToolTip="进入批量编辑：勾选多条内容后批量加/减标签或删除"/>
                                <Button x:Name="ArchBtn" Style="{StaticResource BtnGhostSm}"
                                        Click="ArchBtn_Click"
                                        ToolTip="显示/隐藏归档（点击切换）"/>
                                <Button x:Name="ColsBtn" Style="{StaticResource BtnGhostSm}"
                                        Click="ColsBtn_Click"
                                        ToolTip="点击循环切换列数：自动 → 1 → 2 → 3 → 4 → 自动（M3b-1 接入）"/>
                                <Button x:Name="SyncBtn" Style="{StaticResource BtnGhostSm}" Content="同步"
                                        Click="SyncBtn_Click" ToolTip="立即同步（配置在「数据管理」中）"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ctl:NeuBorder>

                <!-- 卡片墙（对齐 .list：auto-fill 多列 280px 基准 gap 16；M2 接入卡片到 Wall） -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <WrapPanel x:Name="WallPanel" Margin="0,0,0,16" SizeChanged="WallPanel_SizeChanged"/>
                        <TextBlock x:Name="EmptyHint"
                                   Text="还没有内容 — 顶部粘贴框 Ctrl+V 即存，或拖文件进来"
                                   Foreground="{StaticResource DimBrush}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,48,0,48"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 批量操作条（对齐 Web .batch-bar：底部悬浮 elev 卡，居中 max-width 与 ViewGrid 一致；仅批量模式可见） -->
        <Grid x:Name="BatchBar" VerticalAlignment="Bottom" Margin="16,0,16,18"
              MaxWidth="960" HorizontalAlignment="Stretch"
              Visibility="Collapsed">
            <ctl:NeuBorder Kind="Raised" Background="{StaticResource ElevBrush}" CornerRadius="{StaticResource RadiusLg}">
                <StackPanel Orientation="Horizontal" Margin="14,10" VerticalAlignment="Center">
                    <TextBlock x:Name="BatchCountText" Text="已选 0" Foreground="{StaticResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,18,0"/>
                    <Button x:Name="BatchSelectAllBtn" Style="{StaticResource BtnGhostSm}" Content="全选当前页"
                            Margin="0,0,8,0" Click="BatchSelectAllBtn_Click"
                            ToolTip="选中当前过滤下可见的全部内容（再次点击取消全选）"/>
                    <Button x:Name="BatchAddTagBtn" Style="{StaticResource BtnGhostSm}" Content="＋ 加标签"
                            Margin="0,0,8,0" Click="BatchAddTagBtn_Click"
                            ToolTip="为选中内容批量添加标签（可新建）"/>
                    <Button x:Name="BatchRemoveTagBtn" Style="{StaticResource BtnGhostSm}" Content="－ 减标签"
                            Margin="0,0,8,0" Click="BatchRemoveTagBtn_Click"
                            ToolTip="为选中内容批量移除标签"/>
                    <Button x:Name="BatchDelBtn" Style="{StaticResource BtnDanger}" Content="🗑 删除"
                            Margin="0,0,8,0" Click="BatchDelBtn_Click"
                            ToolTip="删除选中内容（不可撤销）"/>
                    <Button x:Name="BatchDoneBtn" Style="{StaticResource BtnPrimary}" Content="完成"
                            Click="BatchDoneBtn_Click" ToolTip="退出批量编辑"/>
                </StackPanel>
            </ctl:NeuBorder>
        </Grid>
    </Grid>
</Window>
