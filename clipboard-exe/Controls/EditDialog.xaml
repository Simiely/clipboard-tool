<!-- Controls/EditDialog.xaml - 编辑弹窗（对齐 app.js openEditModal，M3a 范围：文本/链接；富文本/图片/文件 M3b+）
     结构：edit-head（图标 + 编辑 · 标题 + edit-type 徽章）/ [重复常驻提示] / ① 内容区 / ② 元数据（别名+过期+标签）
           / 操作行（归档 + 保存 + 取消） -->
<UserControl x:Class="ClipboardExe.Controls.EditDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:ClipboardExe.Controls"
             Width="600">
    <Border Style="{StaticResource ModalCard}">
        <StackPanel>
            <!-- edit-head：类型图标 + 标题 + 类型徽章 -->
            <DockPanel Style="{StaticResource ModalHead}">
                <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource InsetBrush}"
                        DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadIcon" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="HeadTitle" FontSize="16" FontWeight="Medium" VerticalAlignment="Center"
                           Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/>
                <ContentControl x:Name="TypeBadge" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 重复常驻提示（.edit-dup：⚠️ 已有相同内容 / 可修改标题或标签） -->
            <Border x:Name="DupTip" Style="{StaticResource DupTip}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="⚠️ 已有相同内容" Foreground="{StaticResource AmberBrush}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="可修改标题或标签，方便下次检索" Foreground="{StaticResource DimBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- ① 内容区（.edit-sec） -->
            <Border Style="{StaticResource SecCard}">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="1" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="Sec1Title" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock x:Name="Sec1Hint" DockPanel.Dock="Right" FontSize="11"
                                   Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBox x:Name="ContentBox" MinHeight="110" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- ② 元数据区（.edit-sec：别名 + 过期 + 标签） -->
            <Border Style="{StaticResource SecCard}" Margin="0">
                <StackPanel>
                    <DockPanel Style="{StaticResource SecTitle}">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{StaticResource BgBrush}"
                                DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="2" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="元数据" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="138"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleBox" Grid.Column="0" Tag="别名" FontSize="12.5"/>
                        <ComboBox x:Name="ExpireBox" Grid.Column="1" Style="{StaticResource DarkCombo}"
                                  Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ctl:TagPicker x:Name="TagPick" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 操作行：归档（非归档时）/ 保存 / 取消 -->
            <StackPanel Style="{StaticResource ModalActions}">
                <Button x:Name="ArchiveBtn" Content="归档" Style="{StaticResource BtnClose}" MinWidth="130"
                        Margin="0,0,10,0" Click="Archive_Click" ToolTip="移入归档区——「含归档」可查看，可恢复或删除"/>
                <Button Content="保存" Style="{StaticResource BtnPrimary}" MinWidth="130" Margin="0,0,10,0" Click="Save_Click"/>
                <Button Content="取消" Style="{StaticResource BtnClose}" MinWidth="130" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
